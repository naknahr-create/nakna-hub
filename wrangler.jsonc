{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nakna-hub",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nakna-hub-db",
      "database_id": "a4fab621-49a6-4e78-88f6-11ef74fe3023",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nakna-hub-assets"
    }
  ],
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
